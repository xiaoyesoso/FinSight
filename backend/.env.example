# Copy this file to .env and fill in real values.

# MiniMax (Anthropic-compatible endpoint) credentials
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M3
MINIMAX_API_KEY=your-minimax-api-key-here
ANTHROPIC_AUTH_TOKEN=your-minimax-api-key-here

# Bocha AI web search
BOCHA_API_KEY=your-bocha-api-key-here

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# OpenTelemetry (optional, opt-in). Unset = telemetry disabled.
# Set the endpoint to enable traces/metrics/log-events export to an OTLP collector.
# Local dev: bring up the collector stack first:
#   docker compose -f extra_doc/11opentelemetry/otel/docker-compose.yml up -d
# then uncomment the line below.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-token
